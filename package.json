{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev --host",
        "start": "concurrently \"nuxt dev\" \"php artisan serve\"",
        "octane": "php artisan octane:start --server=swoole --workers=8 --task-workers=8 --max-requests=300",
        "octane-host": "php artisan octane:start --server=swoole --workers=8 --task-workers=8 --max-requests=300 --host=192.168.254.112 --port=8000",
        "api:test": "wrk -c 100 -t 4 -d 5 http://127.0.0.1:8000/graphql",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "codegen": "graphql-codegen --config codegen.ts",
        "dir-tree": "tree -I \"node_modules|vendor|.nuxt|.output|storage\" --charset=ascii --noreport > DIRECTORY.md",
        "migrate-fresh": "php artisan migrate:fresh --seed"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "3.1.1",
        "@nuxt/eslint": "1.1.0",
        "@nuxt/ui": "2.22.1",
        "@nuxtjs/color-mode": "3.5.2",
        "@nuxtjs/tailwindcss": "6.13.2",
        "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
        "@pinia/nuxt": "^0.11.2",
        "@popperjs/core": "^2.11.8",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "eslint": "^9.0.0",
        "lucide-vue-next": "^0.487.0",
        "nuxt": "^3.17.7",
        "pinia": "^3.0.1",
        "pinia-plugin-persistedstate": "^4.2.0",
        "tailwind-merge": "^3.3.1",
        "v-calendar": "^3.1.2",
        "vue": "latest",
        "vue-router": "latest",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^5.0.5",
        "@graphql-codegen/client-preset": "4.5.1",
        "@graphql-codegen/introspection": "4.0.3",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/solar": "^1.2.2",
        "@nuxtjs/apollo": "^5.0.0-alpha.14",
        "@parcel/watcher": "^2.5.0",
        "@vueuse/core": "^12.7.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.4",
        "concurrently": "^9.1.2",
        "eslint-plugin-perfectionist": "^4.9.0",
        "postcss": "^8.5.3",
        "prettier": "3.5.2",
        "tailwindcss": "3",
        "typescript": "^5.7.3",
        "vite": "^6.0.11",
        "vue-tsc": "^2.2.4"
    }
}
